# No .env is needed for the default local mock product.
RECEIPT_WEB_PROFILE=local
RECEIPT_WEB_STORAGE_ROOT=.receipt-bench
RECEIPT_STORAGE_BACKEND=filesystem
RECEIPT_EXECUTION_MODE=mock
RECEIPT_WORKER_ENABLED=true
RECEIPT_SEED_BUILTIN_PROJECTS=true
RECEIPT_SEED_CORD=true
RECEIPT_SEED_SROIE=true

AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=
AZURE_FOUNDRY_RESOURCE_GROUP=
AZURE_LOCATION=swedencentral
AZURE_FOUNDRY_ACCOUNT=
AZURE_FOUNDRY_CUSTOM_SUBDOMAIN=
AZURE_FOUNDRY_PROJECT=receipt-bench
# auto uses a configured key when present and otherwise uses the developer's
# Microsoft Entra identity. Hosted deployments set entra explicitly.
AZURE_AI_AUTH_MODE=auto
# default uses the developer credential chain; hosted Bicep sets managed_identity.
AZURE_AI_CREDENTIAL_KIND=default
AZURE_FOUNDRY_API_KEY=
AZURE_FOUNDRY_OPENAI_ENDPOINT=
AZURE_FOUNDRY_MODELS_ENDPOINT=
AZURE_ANTHROPIC_ENDPOINT=
AZURE_MISTRAL_OCR_ENDPOINT=
AZURE_CONTENT_UNDERSTANDING_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_VISION_ENDPOINT=

# Hosted App Service uses its managed identity for Foundry inference and to
# resolve endpoint secrets from private Key Vault. The API-key secret is used
# only when AZURE_AI_AUTH_MODE=key.
RECEIPT_WEB_ALLOWED_HOSTS=
RECEIPT_WEB_SROIE_RIGHTS_EVIDENCE=
AZURE_KEY_VAULT_URI=
AZURE_FOUNDRY_API_KEY_SECRET_NAME=foundry-api-key
AZURE_FOUNDRY_OPENAI_ENDPOINT_SECRET_NAME=foundry-openai-endpoint
AZURE_FOUNDRY_MODELS_ENDPOINT_SECRET_NAME=foundry-models-endpoint
AZURE_ANTHROPIC_ENDPOINT_SECRET_NAME=anthropic-endpoint
AZURE_MISTRAL_OCR_ENDPOINT_SECRET_NAME=mistral-ocr-endpoint
AZURE_CONTENT_UNDERSTANDING_ENDPOINT_SECRET_NAME=content-understanding-endpoint
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT_SECRET_NAME=document-intelligence-endpoint
AZURE_VISION_ENDPOINT_SECRET_NAME=vision-endpoint
AZURE_STORAGE_BLOB_ENDPOINT=
AZURE_STORAGE_QUEUE_ENDPOINT=
AZURE_STORAGE_TABLE_ENDPOINT=
